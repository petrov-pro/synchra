<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this phone: conversations are private, and the encrypted settings can't be
  decrypted elsewhere anyway (their Keystore key never moves). Android 12+ ignores
  allowBackup="false" for device-to-device transfer, so that is excluded here explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
